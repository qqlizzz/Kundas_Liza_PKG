import os
import struct
import threading
import tkinter as tk
from tkinter import ttk, filedialog, messagebox
from concurrent.futures import ThreadPoolExecutor, as_completed

class ImageMetaParser:
    @staticmethod
    def parse_file(filepath):
        result = {
            'filename': os.path.basename(filepath),
            'width': None,
            'height': None,
            'dpi': None,
            'color_depth': None,
            'compression': None,
            'status': 'OK',
            'extra': ''
        }
        try:
            with open(filepath, 'rb') as f:
                header = f.read(32)
                if len(header) < 2:
                    result['status'] = 'Файл поврежден'
                    return result
                if header[:2] == b'BM':
                    ImageMetaParser._parse_bmp(f, result)
                elif header[:8] == b'\x89PNG\r\n\x1a\n':
                    ImageMetaParser._parse_png(f, result)
                elif header[:2] == b'\xff\xd8':
                    ImageMetaParser._parse_jpeg(f, result)
                elif header[:6] in (b'GIF87a', b'GIF89a'):
                    ImageMetaParser._parse_gif(f, result)
                elif header[:4] in (b'II*\x00', b'MM\x00*'):
                    ImageMetaParser._parse_tiff(f, result)
                elif header[:1] == b'\x0a':
                    ImageMetaParser._parse_pcx(f, result)
                else:
                    result['status'] = 'Неизвестный формат'
        except Exception:
            result['status'] = 'Файл поврежден'
        return result

    @staticmethod
    def _parse_bmp(f, result):
        f.seek(0)
        data = f.read(54)
        if len(data) < 54:
            result['status'] = 'Файл поврежден'
            return
        file_size = struct.unpack_from('<I', data, 2)[0]
        if os.fstat(f.fileno()).st_size < file_size:
            result['status'] = 'Файл поврежден'
            return
        pixel_offset = struct.unpack_from('<I', data, 10)[0]
        header_size = struct.unpack_from('<I', data, 14)[0]
        width = struct.unpack_from('<i', data, 18)[0]
        height = struct.unpack_from('<i', data, 22)[0]
        planes = struct.unpack_from('<H', data, 26)[0]
        bpp = struct.unpack_from('<H', data, 28)[0]
        compression = struct.unpack_from('<I', data, 30)[0]
        xppm = struct.unpack_from('<i', data, 38)[0]
        yppm = struct.unpack_from('<i', data, 42)[0]
        result['width'] = abs(width)
        result['height'] = abs(height)
        result['color_depth'] = bpp
        if xppm > 0:
            result['dpi'] = round(xppm * 0.0254, 2)
        comp_map = {0: 'BI_RGB', 1: 'BI_RLE8', 2: 'BI_RLE4', 3: 'BI_BITFIELDS'}
        result['compression'] = comp_map.get(compression, f'Unknown({compression})')
        if bpp <= 8:
            colors = 1 << bpp
            result['extra'] = f'Палитра: {colors} цветов'

    @staticmethod
    def _parse_png(f, result):
        f.seek(8)
        ihdr_found = False
        iend_found = False
        while True:
            chunk_header = f.read(8)
            if len(chunk_header) < 8:
                break
            length = struct.unpack('>I', chunk_header[:4])[0]
            chunk_type = chunk_header[4:8]
            if chunk_type == b'IHDR':
                ihdr_data = f.read(13)
                if len(ihdr_data) < 13:
                    result['status'] = 'Файл поврежден'
                    return
                width = struct.unpack('>I', ihdr_data[0:4])[0]
                height = struct.unpack('>I', ihdr_data[4:8])[0]
                bit_depth = ihdr_data[8]
                color_type = ihdr_data[9]
                compression = ihdr_data[10]
                filter_method = ihdr_data[11]
                interlace = ihdr_data[12]
                result['width'] = width
                result['height'] = height
                result['color_depth'] = bit_depth
                ct_map = {0: 'Grayscale', 2: 'Truecolor', 3: 'Indexed', 4: 'Grayscale+Alpha', 6: 'Truecolor+Alpha'}
                result['extra'] = f'Тип цвета: {ct_map.get(color_type, color_type)}, Фильтр: {filter_method}, Интерлейс: {interlace}'
                f.read(4)
                ihdr_found = True
                continue
            elif chunk_type == b'IEND':
                iend_found = True
                break
            f.seek(length + 4, 1)
        if not ihdr_found:
            result['status'] = 'Файл поврежден'
        elif not iend_found:
            result['status'] = 'Файл поврежден'
        if 'dpi' not in result or result['dpi'] is None:
            result['dpi'] = 'N/A'

    @staticmethod
    def _parse_jpeg(f, result):
        f.seek(2)
        eoi_found = False
        while True:
            byte = f.read(1)
            if not byte:
                break
            if byte != b'\xff':
                continue
            marker = f.read(1)
            while marker == b'\xff':
                marker = f.read(1)
            if not marker:
                break
            m = marker[0]
            if m == 0xD9:
                eoi_found = True
                break
            if m in (0xD0, 0xD1, 0xD2, 0xD3, 0xD4, 0xD5, 0xD6, 0xD7, 0x01):
                continue
            if m == 0xDA:
                break
            length_bytes = f.read(2)
            if len(length_bytes) < 2:
                break
            length = struct.unpack('>H', length_bytes)[0]
            if length < 2:
                break
            if m in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                seg = f.read(6)
                if len(seg) < 6:
                    result['status'] = 'Файл поврежден'
                    return
                precision = seg[0]
                height = struct.unpack('>H', seg[1:3])[0]
                width = struct.unpack('>H', seg[3:5])[0]
                result['width'] = width
                result['height'] = height
                result['color_depth'] = precision * struct.unpack('>H', f.read(2))[0] if False else precision
                num_components = seg[5]
                result['color_depth'] = precision * num_components
                result['compression'] = {0xC0: 'Baseline', 0xC1: 'Extended sequential', 0xC2: 'Progressive'}.get(m, f'SOF{m:02X}')
                f.seek(length - 8, 1)
            elif m == 0xE0:
                seg = f.read(length - 2)
                if len(seg) >= 12 and seg[:5] == b'JFIF\x00':
                    units = seg[7]
                    xdens = struct.unpack('>H', seg[8:10])[0]
                    ydens = struct.unpack('>H', seg[10:12])[0]
                    if units == 1:
                        result['dpi'] = xdens
                    elif units == 2:
                        result['dpi'] = round(xdens * 2.54, 2)
                    else:
                        result['dpi'] = 'N/A'
            elif m == 0xE1:
                seg = f.read(length - 2)
                if len(seg) >= 14 and seg[:6] == b'Exif\x00\x00':
                    pass
            else:
                f.seek(length - 2, 1)
        if result['width'] is None:
            result['status'] = 'Файл поврежден'
        if not eoi_found:
            pass
        if result.get('dpi') is None:
            result['dpi'] = 'N/A'

    @staticmethod
    def _parse_gif(f, result):
        f.seek(0)
        data = f.read(13)
        if len(data) < 13:
            result['status'] = 'Файл поврежден'
            return
        width = struct.unpack('<H', data[6:8])[0]
        height = struct.unpack('<H', data[8:10])[0]
        packed = data[10]
        gct_flag = (packed >> 7) & 1
        color_res = ((packed >> 4) & 7) + 1
        gct_size = 2 ** ((packed & 7) + 1) if gct_flag else 0
        result['width'] = width
        result['height'] = height
        result['color_depth'] = color_res
        result['compression'] = 'LZW'
        result['dpi'] = 'N/A'
        if gct_flag:
            result['extra'] = f'Палитра: {gct_size} цветов'

    @staticmethod
    def _parse_tiff(f, result):
        f.seek(0)
        data = f.read(8)
        if len(data) < 8:
            result['status'] = 'Файл поврежден'
            return
        if data[:2] == b'II':
            endian = '<'
        else:
            endian = '>'
        magic = struct.unpack(endian + 'H', data[2:4])[0]
        if magic != 42:
            result['status'] = 'Файл поврежден'
            return
        ifd_offset = struct.unpack(endian + 'I', data[4:8])[0]
        f.seek(ifd_offset)
        num_entries_data = f.read(2)
        if len(num_entries_data) < 2:
            result['status'] = 'Файл поврежден'
            return
        num_entries = struct.unpack(endian + 'H', num_entries_data)[0]
        tags = {}
        for _ in range(num_entries):
            entry = f.read(12)
            if len(entry) < 12:
                break
            tag = struct.unpack(endian + 'H', entry[0:2])[0]
            typ = struct.unpack(endian + 'H', entry[2:4])[0]
            count = struct.unpack(endian + 'I', entry[4:8])[0]
            value_bytes = entry[8:12]
            if typ == 3 and count == 1:
                val = struct.unpack(endian + 'H', value_bytes[:2])[0]
            elif typ == 4 and count == 1:
                val = struct.unpack(endian + 'I', value_bytes)[0]
            else:
                val = value_bytes
            tags[tag] = val
        width = tags.get(256)
        height = tags.get(257)
        bits = tags.get(258)
        compression = tags.get(259)
        xres = tags.get(282)
        yres = tags.get(283)
        res_unit = tags.get(296)
        result['width'] = width
        result['height'] = height
        if isinstance(bits, int):
            result['color_depth'] = bits
        elif isinstance(bits, bytes) and len(bits) >= 2:
            result['color_depth'] = struct.unpack(endian + 'H', bits[:2])[0]
        else:
            result['color_depth'] = bits
        comp_map = {1: 'None', 2: 'CCITT RLE', 5: 'LZW', 6: 'JPEG', 7: 'JPEG', 8: 'Deflate', 32773: 'PackBits'}
        if isinstance(compression, int):
            result['compression'] = comp_map.get(compression, str(compression))
        else:
            result['compression'] = str(compression)
        if isinstance(xres, int) and isinstance(res_unit, int) and res_unit == 2:
            result['dpi'] = xres
        elif isinstance(xres, tuple):
            result['dpi'] = xres[0]
        else:
            result['dpi'] = 'N/A'
        if result['width'] is None or result['height'] is None:
            result['status'] = 'Файл поврежден'

    @staticmethod
    def _parse_pcx(f, result):
        f.seek(0)
        data = f.read(128)
        if len(data) < 128:
            result['status'] = 'Файл поврежден'
            return
        if data[0] != 0x0A:
            result['status'] = 'Файл поврежден'
            return
        version = data[1]
        encoding = data[2]
        bpp = data[3]
        xmin = struct.unpack('<H', data[4:6])[0]
        ymin = struct.unpack('<H', data[6:8])[0]
        xmax = struct.unpack('<H', data[8:10])[0]
        ymax = struct.unpack('<H', data[10:12])[0]
        hdpi = struct.unpack('<H', data[12:14])[0]
        vdpi = struct.unpack('<H', data[14:16])[0]
        result['width'] = xmax - xmin + 1
        result['height'] = ymax - ymin + 1
        result['color_depth'] = bpp * 8 if bpp <= 8 else bpp
        result['dpi'] = hdpi if hdpi > 0 else 'N/A'
        enc_map = {0: 'Raw', 1: 'RLE'}
        result['compression'] = enc_map.get(encoding, str(encoding))
        result['extra'] = f'Версия: {version}, Бит на плоскость: {bpp}'

class App:
    def __init__(self, root):
        self.root = root
        self.root.title('Image Metadata Parser')
        self.root.geometry('1200x700')
        self.folder = tk.StringVar()
        self.results = []
        self._build_ui()

    def _build_ui(self):
        top = ttk.Frame(self.root, padding=5)
        top.pack(fill=tk.X)
        ttk.Entry(top, textvariable=self.folder, width=80).pack(side=tk.LEFT, padx=5)
        ttk.Button(top, text='Обзор', command=self.browse).pack(side=tk.LEFT, padx=5)
        ttk.Button(top, text='Сканировать', command=self.scan).pack(side=tk.LEFT, padx=5)
        self.progress = ttk.Progressbar(self.root, mode='determinate')
        self.progress.pack(fill=tk.X, padx=5, pady=2)
        self.status_label = ttk.Label(self.root, text='Готов')
        self.status_label.pack(anchor=tk.W, padx=5)
        cols = ('filename', 'width', 'height', 'dpi', 'color_depth', 'compression', 'status', 'extra')
        self.tree = ttk.Treeview(self.root, columns=cols, show='headings')
        for c in cols:
            self.tree.heading(c, text=c)
            self.tree.column(c, width=120, anchor=tk.W)
        self.tree.column('filename', width=200)
        self.tree.column('extra', width=250)
        self.tree.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)
        vsb = ttk.Scrollbar(self.tree, orient='vertical', command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)

    def browse(self):
        d = filedialog.askdirectory()
        if d:
            self.folder.set(d)

    def scan(self):
        folder = self.folder.get()
        if not folder or not os.path.isdir(folder):
            messagebox.showerror('Ошибка', 'Укажите корректную папку')
            return
        for item in self.tree.get_children():
            self.tree.delete(item)
        self.results = []
        files = []
        for root_dir, _, filenames in os.walk(folder):
            for fn in filenames:
                files.append(os.path.join(root_dir, fn))
        total = len(files)
        if total == 0:
            self.status_label.config(text='Файлы не найдены')
            return
        self.progress['maximum'] = total
        self.progress['value'] = 0
        self.status_label.config(text=f'Обработка {total} файлов...')
        threading.Thread(target=self._process_files, args=(files, total), daemon=True).start()

    def _process_files(self, files, total):
        results = []
        with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as executor:
            futures = {executor.submit(ImageMetaParser.parse_file, fp): fp for fp in files}
            done = 0
            for future in as_completed(futures):
                try:
                    res = future.result()
                except Exception:
                    res = {'filename': os.path.basename(futures[future]), 'status': 'Ошибка', 'width': None, 'height': None, 'dpi': None, 'color_depth': None, 'compression': None, 'extra': ''}
                results.append(res)
                done += 1
                if done % 10 == 0 or done == total:
                    self.root.after(0, self._update_progress, done, total)
        self.root.after(0, self._display_results, results)

    def _update_progress(self, done, total):
        self.progress['value'] = done
        self.status_label.config(text=f'Обработано {done} из {total}')

    def _display_results(self, results):
        results.sort(key=lambda x: x['filename'])
        for r in results:
            self.tree.insert('', tk.END, values=(
                r.get('filename', ''),
                r.get('width', ''),
                r.get('height', ''),
                r.get('dpi', ''),
                r.get('color_depth', ''),
                r.get('compression', ''),
                r.get('status', ''),
                r.get('extra', '')
            ))
        self.status_label.config(text=f'Готово. Обработано {len(results)} файлов.')

if __name__ == '__main__':
    root = tk.Tk()
    app = App(root)
    root.mainloop()
